<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DCL_snapshpt1</AssemblyName>
    <RootNamespace>DCL_Launcher</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <Optimize>true</Optimize>
    <TieredCompilation>true</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="DCL_Launcher.app.ico" />
    <EmbeddedResource Include="Data\mcmod-zh-cn.tsv.gz" LogicalName="DCL_Launcher.Data.mcmod-zh-cn.tsv.gz" />
    <EmbeddedResource Include="..\ui-prototype\**\*"
                      Exclude="..\ui-prototype\verify-preflight.cjs;..\ui-prototype\preview-server.cjs;..\ui-prototype\.git\**"
                      LogicalName="ui\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <UsingTask TaskName="GenerateBuildSecretsTask"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ExplicitKey ParameterType="System.String" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Security.Cryptography" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        string key = (ExplicitKey ?? "").Trim();
        if (key.Length == 0)
        {
            key = (Environment.GetEnvironmentVariable("DCL_BUILD_CURSEFORGE_KEY") ?? "").Trim();
        }

        string code;
        if (key.Length == 0)
        {
            code =
                "// <auto-generated />\n" +
                "namespace DCL_Launcher;\n\n" +
                "internal static class BuildSecrets\n" +
                "{\n" +
                "    public static string CurseForgeApiKey => \"\";\n" +
                "}\n";
        }
        else
        {
            byte[] plain = Encoding.UTF8.GetBytes(key);
            byte[] mask;
            using (var sha = SHA256.Create())
            {
                mask = sha.ComputeHash(Encoding.UTF8.GetBytes("DCL-CF-BUILD-MASK-V1:" + plain.Length));
            }
            byte[] encoded = new byte[plain.Length];
            for (int i = 0; i < plain.Length; i++)
            {
                encoded[i] = (byte)(plain[i] ^ mask[i % mask.Length] ^ (byte)((i * 31 + 17) & 0xFF));
            }
            string encLiteral = string.Join(", ", encoded.Select(b => "0x" + b.ToString("X2")));
            string maskLiteral = string.Join(", ", mask.Select(b => "0x" + b.ToString("X2")));
            code =
                "// <auto-generated />\n" +
                "#nullable enable\n" +
                "using System.Text;\n\n" +
                "namespace DCL_Launcher;\n\n" +
                "internal static class BuildSecrets\n" +
                "{\n" +
                "    private static readonly byte[] EncodedCf = new byte[] { " + encLiteral + " };\n" +
                "    private static readonly byte[] MaskCf = new byte[] { " + maskLiteral + " };\n" +
                "    private static string? _cachedCf;\n\n" +
                "    public static string CurseForgeApiKey\n" +
                "    {\n" +
                "        get\n" +
                "        {\n" +
                "            if (_cachedCf != null) return _cachedCf;\n" +
                "            byte[] buf = new byte[EncodedCf.Length];\n" +
                "            for (int i = 0; i < EncodedCf.Length; i++)\n" +
                "                buf[i] = (byte)(EncodedCf[i] ^ MaskCf[i % MaskCf.Length] ^ (byte)((i * 31 + 17) & 0xFF));\n" +
                "            return _cachedCf = Encoding.UTF8.GetString(buf);\n" +
                "        }\n" +
                "    }\n" +
                "}\n";
        }

        Directory.CreateDirectory(Path.GetDirectoryName(OutputFile)!);
        if (!File.Exists(OutputFile) || File.ReadAllText(OutputFile) != code)
        {
            File.WriteAllText(OutputFile, code, new UTF8Encoding(false));
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="GenerateBuildSecrets" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_BuildSecretsFile>$(IntermediateOutputPath)BuildSecrets.g.cs</_BuildSecretsFile>
    </PropertyGroup>
    <GenerateBuildSecretsTask ExplicitKey="$(CurseForgeApiKey)" OutputFile="$(_BuildSecretsFile)" />
    <ItemGroup>
      <Compile Include="$(_BuildSecretsFile)" />
      <FileWrites Include="$(_BuildSecretsFile)" />
    </ItemGroup>
  </Target>
</Project>
